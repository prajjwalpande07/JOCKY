# Database configuration (PostgreSQL or fallback SQLite)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jocky_forensics
SQLITE_FALLBACK_URL=sqlite:///./data/jocky.db

# Security & JWT Auth
SECRET_KEY=jocky-forensic-threat-hunting-secret-key-jwt-2026-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
